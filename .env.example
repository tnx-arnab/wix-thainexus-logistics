# Public app host
APP_URL=https://wix.thainexus.co.th
AUTH_CALLBACK=https://wix.thainexus.co.th/api/auth

# Wix App Dashboard
WIX_APP_ID=
WIX_APP_SECRET=
# PEM public key for SPI / webhook JWT verify (use \n for newlines in single-line secrets)
WIX_PUBLIC_KEY=

# App secrets (generate NEW values - do not reuse BC/Shopify)
JWT_KEY=
ENCRYPTION_KEY=

# Thai Nexus Cloud Functions
THAI_NEXUS_FUNCTIONS_URL=https://app.thainexus.co.th/functions/
THAI_NEXUS_TIMEOUT_MS=7000
THAI_NEXUS_SHIPMENT_TIMEOUT_MS=15000

# Runtime
NODE_ENV=development
DEBUG_MODE=true
API_PORT=3001
ADMIN_DEV_URL=http://localhost:5173

# Local only - never in production
WEBHOOK_SKIP_VERIFY=true

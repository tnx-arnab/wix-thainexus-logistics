{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx"
  },
  "include": [
    "admin/src/**/*.ts",
    "admin/src/**/*.tsx",
    "api/src/**/*.ts",
    "shared/src/**/*.ts"
  ],
  "exclude": ["node_modules", "**/dist"]
}
